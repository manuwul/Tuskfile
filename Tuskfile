#!/usr/bin/env bash

# ========== SCRIPT CONFIGS ==========
IGNOREFORMAT=(
	"_*"
	"log"
	"default"
)

TIMEFORMAT="Task completed in %3lR"

if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    COLOR_RESET="\033[0m"
	COLOR_ERROR="\033[38;5;196m"
	COLOR_FUNCTION="\033[38;5;165m"
	COLOR_COMMENT="\033[38;5;229m"
	COLOR_LOG="\033[38;5;247m"
else
    COLOR_RESET=""
    COLOR_ERROR=""
    COLOR_FUNCTION=""
    COLOR_COMMENT=""
    COLOR_LOG=""
fi


# ========== TASKS ==========
final() { : "Final func"
	return 0
}

fourth() {
	return 0
}

third_() { : "third?"
	return 0
}

third() { : 'third'
	log fourth "Hello world"
}

second() { : "Second"
	log third "b" && log third_ "c"
}

first() { : 'first'
	log second "a"
	log third
}


# ========== DEFAULT ==========
default() {
	log help
}


# ========== LOG + HELP ==========
depths=()
log() { : "Logs function execution in pretty format"
	if [[ -t 1 ]] && [[ -z "${NO_LOG:-}" ]]; then
		local depth=-1
		for func_name in "${FUNCNAME[@]}"; do
        	[[ "$func_name" == "log" ]] && ((depth++))
    	done

		local args=""
		for arg in "$@"; do
    		if [[ "$arg" == *" "* ]]; then
        		args+="\"$arg\" "
    		else
        		args+="$arg "
    		fi
		done
		
		local prefix=$(printf "%$(( (depth) * 2 ))s" "")
		prefix="${prefix/%  /┗━}"
		printf "${COLOR_LOG}%s%s${COLOR_RESET}\n" "$prefix" "$args"
		
		if (( "$depth" != 0 )); then
			printf "\033[2A\033[$(( depth * 2 - 1 ))G"
			
			local i=$((${#depths[@]} - 1))
			for (( i; i >= 0; i-- )); do
				if (( ${depths[$i]} > $depth )); then
					printf "${COLOR_LOG}┃${COLOR_RESET}\033[1D\033[1A"
					continue
				fi
				
				if (( ${depths[$i]} == $depth )); then
					printf "${COLOR_LOG}┣${COLOR_RESET}"
				fi
				break
			done

			printf "\033[$(( ${#depths[@]} - i + 1 ))E"
		fi
		depths+=("$depth")
	fi

		
	"$@"
}

help() { : "Shows this help message"
	echo "Usage: $0 <task> [args]"
	echo "Tasks:"
	
	local i=1
	for func_name in $(compgen -A function); do
		local skip=0

		for glob in "${IGNOREFORMAT[@]}"; do case "$func_name" in $glob) skip=1 && break ;; esac done
		[[ $skip == 1 ]] && continue

		local func_body=$(declare -f "$func_name")
		[[ "$func_body" != *": "[\'\"]*[\'\"]* ]] && func_body=""
		func_body="${func_body#*": "[\'\"]}"
		func_body="${func_body%%[\'\"]*}"
		
		printf "\t%d) ${COLOR_FUNCTION}%-12s${COLOR_RESET} ${COLOR_COMMENT}%s${COLOR_RESET}\n" "$((i++))" "$func_name" "$func_body"
	done
}


# ========== MAIN ==========
task="${1:-default}"
shift

# check if task exists
if ! (declare -F "${task}" >/dev/null); then
	printf "${COLOR_ERROR}Unknown task: %s${COLOR_RESET}\n" "${task}"
	help
	exit 127
fi

time "$task" "$@"
